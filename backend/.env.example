# CaseBridge AI — Backend environment variables
#
# Copy this file to .env and fill in the values for your local environment.
# The .env file is excluded from version control (.gitignore).
# Never commit real credentials to this file.
#
#   cp .env.example .env
#

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #

# Deployment environment.  Affects logging verbosity and whether OpenAPI docs
# (/docs, /redoc) are served.
# Values: development | staging | production
APP_ENV=development

# --------------------------------------------------------------------------- #
# CORS
# --------------------------------------------------------------------------- #

# Comma-separated list of frontend origins allowed to make cross-origin
# requests to the API.
# Examples:
#   http://localhost:3000          — Vite / Next.js dev server
#   http://localhost:5173          — Vite default port
#   https://casebridge.example.com — production frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------------------------------------- #
# Database
# --------------------------------------------------------------------------- #

# Async SQLAlchemy / asyncpg connection URL.
# The readiness probe at /api/v1/health/ready reports "degraded" until set.
# Database-dependent routes raise a clear error if called without this value.
# Format:  postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Example: postgresql+asyncpg://casebridge:secret@localhost:5432/casebridge
DATABASE_URL=

# --------------------------------------------------------------------------- #
# AI / Matching engine  (future tasks)
# --------------------------------------------------------------------------- #

# Minimum cosine similarity (0.0–1.0) for two complaints to be flagged as
# potentially overlapping.
AI_SIMILARITY_THRESHOLD=0.75

# Maximum number of candidate overlap matches returned per complaint.
AI_MAX_OVERLAP_CANDIDATES=10

# --------------------------------------------------------------------------- #
# Logging
# --------------------------------------------------------------------------- #

# Python log level for the application.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
